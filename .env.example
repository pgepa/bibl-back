# ==============================================================================
# SISBIB - BIBLIOTECA PGE-PA (BACKEND) - MODELO DE CONFIGURAÇÃO (.env.example)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para ".env" no mesmo diretório:
#    cp .env.example .env
# 2. Preencha as variáveis abaixo com os valores do seu ambiente local ou de produção.
# ==============================================================================

# Porta do servidor Spring Boot
SERVER_PORT=8080

# Conexão com o banco de dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/nome_do_seu_banco
DB_USERNAME=seu_usuario_postgres
DB_PASSWORD=sua_senha_segura

# Segredo para assinatura de Tokens JWT (HMAC-SHA256)
# Recomendado: utilizar uma chave com pelo menos 32 caracteres alfanuméricos
JWT_SECRET=sua_chave_secreta_jwt_super_segura_aqui

# Credenciais de acesso inicial (Demonstração / Ilustrativo)
ADMIN_USER_NAME=Administrador do Sistema
ADMIN_USER_EMAIL=admin@exemplo.gov.br
ADMIN_USER_PASS=senha_forte_aqui
ADMIN_USER_MATRICULA=ADM-001
ADMIN_USER_SETOR=Biblioteca Central
